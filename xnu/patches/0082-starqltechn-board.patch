+#define STARQ_GCC_PA          0x00100000u
+#define STARQ_GCC_SIZE        0x00060000u  /* covers 0x18xxx (QUP RCGs) and 0x5200c */
+/* tlmm: pinctrl@3400000, reg 0xc00000; NORTH is the +0x500000 tile, so the
+ * pins used here (31/32, 55/56, 120, 127/128) all live at 0x3900000 + 0x1000*n.
+ * One 1MB mapping reaches pin 0xff, past the highest one used. */
+#define STARQ_TLMM_NORTH_PA   0x03900000u
+#define STARQ_TLMM_NORTH_SIZE 0x00100000u  /* covers pin 0xff (ctl 0xff000) */
+
+/* GENI I2C serial engines (sdm845.dtsi: qupv3_id_1 at 0xac0000). */
+#define STARQ_I2C_TOUCH_SE    0x00a8c000u  /* i2c11, wrapper 1 SE 3 */
+#define STARQ_I2C_FG_SE       0x00a88000u  /* i2c10, wrapper 1 SE 2 */
+#define STARQ_SE_SIZE         0x4000u
+
+/*
+ * gcc-sdm845.c clock branches: enable bit in GCC_CLK_BRANCH_ENA_VOTE
+ * (0x5200c) plus the RCG command register and the branch halt bit.
+ */
+#define STARQ_GCC_VOTE        0x0005200cu
+#define STARQ_GCC_QUP1_M_AHB  0x0001800cu  /* gcc_qupv3_wrap_1_m_ahb_clk */
+#define STARQ_GCC_QUP1_S_AHB  0x00018010u  /* gcc_qupv3_wrap_1_s_ahb_clk */
+#define STARQ_VOTE_M_AHB      (1u << 20)
+#define STARQ_VOTE_S_AHB      (1u << 21)
+#define STARQ_VOTE_SE2        (1u << 24)   /* gcc_qupv3_wrap1_s2_clk */
+#define STARQ_VOTE_SE3        (1u << 25)   /* gcc_qupv3_wrap1_s3_clk */
+#define STARQ_GCC_SE2_HALT    0x00018274u
+#define STARQ_GCC_SE2_RCG     0x00018278u
+#define STARQ_GCC_SE3_HALT    0x000183a4u
+#define STARQ_GCC_SE3_RCG     0x000183a8u
+#define STARQ_CBCR_CLK_OFF    (1u << 31)
+
+/* GENI SE registers (include/linux/soc/qcom/geni-se.h). */
+#define SE_STATUS       0x040u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/*
+ * geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB to LSB, length 8, STOP only on packing vector 3.  FIFO bytes stay LSB
+ * first, so a message is written as one word with the first byte in bits
+ * 7:0.  Same values the SWEET SE7 port uses (patch 0063).
+ */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+/* 19.2 MHz source, 100 kHz: clk_div 7, t_high 10, t_low 12, t_cycle 26. */
+#define SE_SCL_100K     ((10u << 20) | (12u << 10) | 26u)
+
+/* TLMM pin registers (drivers/pinctrl/qcom/pinctrl-sdm845.c). */
+#define TLMM_CTL(pin)   (0x1000u * (uint32_t)(pin))
+#define TLMM_IO(pin)    (TLMM_CTL(pin) + 4u)
+#define TLMM_MUX(f)     ((uint32_t)(f) << 2)
+/* Drive strength is a raw 3-bit field: 0 = 2 mA, 1 = 4 mA, ... 7 = 16 mA
+ * (qcom,tlmm drive-strength, the DT's <2> and <8> are 0 and 3). */
+#define TLMM_DRV(raw)   ((uint32_t)(raw) << 6)
+#define TLMM_PULL_UP    3u
+#define TLMM_PULL_NONE  0u
+#define TLMM_OE         (1u << 9)
+#define TLMM_OUT_HIGH   (1u << 1)
+#define TLMM_IN         (1u << 0)
+
+/* Samsung S2DOS05 (include/linux/regulator/s2dos05.h). */
+#define S2DOS05_ADDR    0x60u
+#define S2DOS05_DEV_ID  0x00u
+#define S2DOS05_EN      0x03u
+#define S2DOS05_LDO2    0x05u
+#define S2DOS05_LDO3    0x06u
+#define S2DOS05_EN_LDO2 (1u << 1)
+#define S2DOS05_EN_LDO3 (1u << 2)
+#define S2DOS05_VSEL_LDO2_1P8  12u  /* (1800000 - 1500000) / 25000 */
+#define S2DOS05_VSEL_LDO3_3P0  12u  /* (3000000 - 2700000) / 25000 */
+
+#define STARQ_I2C21_SDA 127u
+#define STARQ_I2C21_SCL 128u
+#define STARQ_TOUCH_IRQ 120u
+#define STARQ_TOUCH_SDA 31u         /* qup11_i2c SDA/SCL (mainline DT) */
+#define STARQ_TOUCH_SCL 32u
+#define STARQ_FG_SDA    55u         /* qup10_i2c SDA/SCL (mainline DT) */
+#define STARQ_FG_SCL    56u
+
+/* Samsung S6SY761 (drivers/input/touchscreen/s6sy761.c). */
+#define TS_ADDR         0x48u
+#define TS_SENSE_ON     0x10u
+#define TS_SENSE_OFF    0x11u
+#define TS_FW_INTEGRITY 0x21u
+#define TS_PANEL_INFO   0x23u
+#define TS_TOUCH_FUNC   0x30u
+#define TS_DEVICE_ID    0x52u
+#define TS_BOOT_STATUS  0x55u
+#define TS_READ_ONE     0x60u
+#define TS_READ_ALL     0x61u
+#define TS_CLEAR_STACK  0x62u
+#define TS_FW_OK        0x80u
+#define TS_BS_APPL      0x20u
+#define TS_EVENT_ID_INFO 0x02u
+#define TS_EVENT_ID_VENDOR_INFO 0x07u
+#define TS_BOOT_COMPLETE 0x00u
+#define TS_EVENT_SIZE   8u
+#define TS_EVENT_COUNT  32u        /* event stack depth, incl. the one read */
+#define TS_FINGERS      10u
+#define TS_FUNC_TOUCH   0x0001u
