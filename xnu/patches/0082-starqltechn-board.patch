+#define MAX77705_CHG     0x69u
+#define FG_STATUS        0x00u     /* bit 3: battery absent */
+#define FG_SOCREP        0x06u     /* 16-bit LE, 1/256 % */
+#define FG_TEMPERATURE   0x08u
+#define FG_VCELL         0x09u     /* 16-bit LE, 78.125 uV/LSB */
+#define FG_CURRENT       0x0au     /* signed 16-bit LE, 0.3125 mA/LSB */
+#define CHG_INT_OK       0xb2u     /* bit 6: CHGIN_OK */
+#define CHG_DETAILS_01   0xb4u     /* bits 3:0: 0-2 charging, 3-4 done */
