+/* ------------------------------------------------------------------ */
+/* GENI I2C serial engine                                             */
+/* ------------------------------------------------------------------ */
+
+struct starq_geni {
+	vm_offset_t se;
+	uint32_t    vote;           /* GCC_CLK_BRANCH_ENA_VOTE bits */
+	uint32_t    halt;           /* SE branch halt register */
+	uint32_t    rcg;            /* SE RCG command register */
+	const char *name;
+	bool        dead;
+	bool        probing;
+	uint32_t    irq_last;
+	uint32_t    irq_status;
+	unsigned    sent;
+	unsigned    got;
+};
+
+static struct starq_geni starq_touch_se = {
+	.vote = STARQ_VOTE_M_AHB | STARQ_VOTE_S_AHB | STARQ_VOTE_SE3,
+	.halt = STARQ_GCC_SE3_HALT,
+	.rcg = STARQ_GCC_SE3_RCG,
+	.name = "touch i2c11",
+};
+static struct starq_geni starq_fg_se = {
+	.vote = STARQ_VOTE_M_AHB | STARQ_VOTE_S_AHB | STARQ_VOTE_SE2,
+	.halt = STARQ_GCC_SE2_HALT,
+	.rcg = STARQ_GCC_SE2_RCG,
+	.name = "fuel gauge i2c10",
+};
+
+static vm_offset_t starq_gcc, starq_tlmm;
+
+static uint32_t
+starq_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+starq_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+starq_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&starq_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+starq_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(starq_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/*
+ * TLMM pad: mux selects the function, bias and drive strength follow the DT
+ * of the board, output enable is bit 9 of the ctl register.  The output
+ * latch is set before the pin becomes an output so no glitch is driven.
+ */
+static void
+starq_tlmm_cfg(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out)
+{
+	uint32_t cfg = starq_rd(starq_tlmm, TLMM_CTL(pin));
+	if (out) {
+		uint32_t io = starq_rd(starq_tlmm, TLMM_IO(pin));
+		starq_wr(starq_tlmm, TLMM_IO(pin), io | TLMM_OUT_HIGH);
+	}
+	cfg &= ~0x3ffu;
+	cfg |= TLMM_MUX(mux) | pull | TLMM_DRV(drive) | (out ? TLMM_OE : 0);
+	starq_wr(starq_tlmm, TLMM_CTL(pin), cfg);
+}
+
+/* Vote the wrapper AHB and this SE's branch on, keeping other users' bits. */
+static bool
+starq_geni_clocks(struct starq_geni *g)
+{
+	starq_wr(starq_gcc, STARQ_GCC_VOTE, starq_rd(starq_gcc, STARQ_GCC_VOTE) | g->vote);
+
+	/* Source = XO (parent 0), divider 1: 19.2 MHz, as the mainline DT asks. */
+	uint32_t cfg = starq_rd(starq_gcc, g->rcg + 4u);
+	if ((cfg & 0x371fu) != 1u) {
+		starq_wr(starq_gcc, g->rcg + 4u, (cfg & ~(0x371fu | (1u << 20))) | 1u);
+		starq_wr(starq_gcc, g->rcg, starq_rd(starq_gcc, g->rcg) | 1u);
+		if (!starq_wait_clear(starq_gcc, g->rcg, 1u)) {
+			printf("STARQ %s: RCG update timeout (rcg=%#x cfg=%#x)\n",
+			    g->name, starq_rd(starq_gcc, g->rcg), cfg);
+			return false;
+		}
+	}
+	const uint32_t branches[] = {
+		STARQ_GCC_QUP1_M_AHB, STARQ_GCC_QUP1_S_AHB, g->halt,
+	};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!starq_wait_clear(starq_gcc, branches[i], STARQ_CBCR_CLK_OFF)) {
+			printf("STARQ %s: GCC branch %#x halted (%#x)\n", g->name,
+			    branches[i], starq_rd(starq_gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Called only for a transfer this driver started, including a stretched TX. */
+static void
+starq_geni_abort(struct starq_geni *g)
+{
+	starq_wr(g->se, SE_CTRL, 2);        /* abort the M command, release the bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (starq_rd(g->se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !starq_wait_clear(g->se, SE_STATUS, 1u)) {
+		g->dead = true;
+		printf("STARQ %s: abort failed status=%#x irq=%#x; stopping\n", g->name,
+		    starq_rd(g->se, SE_STATUS), starq_rd(g->se, SE_IRQ));
+	}
+	for (unsigned i = 0; i < 64 && (starq_rd(g->se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)starq_rd(g->se, SE_RX);
+	}
+	starq_wr(g->se, SE_IRQ_CLR, 0xffffffffu);
+	if (starq_rd(g->se, SE_TX_COUNT) & 0xfffffffu) {
+		g->dead = true;
+		printf("STARQ %s: TX FIFO not empty after abort; stopping\n", g->name);
+	}
+}
+
+/* Keep every observed IRQ bit for the diagnostics. */
+static uint32_t
+starq_geni_irq(struct starq_geni *g)
+{
+	g->irq_last = starq_rd(g->se, SE_IRQ);
+	g->irq_status |= g->irq_last;
+	return g->irq_last;
+}
+
+/*
+ * One GENI FIFO message: a write of up to 3 bytes, or a read of up to 90
+ * bytes (the 32-word RX FIFO), never both.  STOP_STRETCH (bit 2 of the M
+ * command) keeps the bus for the repeated start a register read needs.
+ */
+static int
+starq_geni_msg_run(struct starq_geni *g, uint8_t addr, const uint8_t *tx,
+    unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	if (g->dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!starq_wait_clear(g->se, SE_STATUS, 1u)) {
+		g->dead = true;         /* no other SE user is supported */
+		return EBUSY;
+	}
+	starq_wr(g->se, SE_IRQ_CLR, 0xffffffffu);
+	starq_wr(g->se, SE_TX_WM, nt ? 1u : 0u);
+	starq_wr(g->se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	starq_wr(g->se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = starq_geni_irq(g);
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/*
+			 * A completed NACK is normal while probing.  Wait for
+			 * DONE and leave the engine idle rather than aborting.
+			 */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = starq_geni_irq(g);
+			}
+			if ((irq & SE_DONE) && !(starq_rd(g->se, SE_STATUS) & 1u) &&
+			    !(starq_rd(g->se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(starq_rd(g->se, SE_RX_COUNT) & 0x1ffffffu)) {
+				starq_wr(g->se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !g->sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			starq_wr(g->se, SE_TX, word);
+			g->sent = nt;
+			starq_wr(g->se, SE_TX_WM, 0);
+		}
+		uint32_t count = starq_rd(g->se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - g->got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = starq_rd(g->se, SE_RX);
+			for (unsigned j = 0; j < 4 && g->got < nr; ++j) {
+				rx[g->got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX so final short words are kept. */
+		if (irq & SE_DONE) {
+			irq = starq_geni_irq(g);        /* a late error beats DONE */
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			starq_wr(g->se, SE_IRQ_CLR, irq);
+			if (g->got == nr && g->sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		starq_wr(g->se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	starq_geni_abort(g);
+	return err;
+}
+
+static int
+starq_geni_msg(struct starq_geni *g, uint8_t addr, const uint8_t *tx,
+    unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	g->irq_status = g->irq_last = 0;
+	g->sent = g->got = 0;
+	int err = starq_geni_msg_run(g, addr, tx, nt, rx, nr, stretch);
+	if (g->probing) {
+		printf("STARQ %s: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u\n",
+		    g->name, addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, g->irq_last, g->irq_status, g->sent, g->got);
+	}
+	return err;
+}
+
+/*
+ * Register read: write the 8-bit register pointer with STOP_STRETCH, then
+ * read from the same address with a repeated start.  Both the S6SY761 and
+ * the MAX77705 use plain 8-bit register pointers.
+ */
+static int
+starq_geni_read(struct starq_geni *g, uint8_t addr, uint8_t reg,
+    uint8_t *buf, unsigned len)
+{
+	int err = starq_geni_msg(g, addr, &reg, 1, NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	return starq_geni_msg(g, addr, NULL, 0, buf, len, false);
+}
+
+static bool
+starq_geni_init(struct starq_geni *g, uint32_t se_pa, unsigned sda, unsigned scl)
+{
+	g->se = ml_io_map(se_pa, STARQ_SE_SIZE);
+	if (!g->se) {
+		printf("STARQ %s: SE mapping failed\n", g->name);
+		return false;
+	}
+	uint32_t fw = starq_rd(g->se, SE_FW);
+	uint32_t tx = starq_rd(g->se, SE_HW_TX), rx = starq_rd(g->se, SE_HW_RX);
+	printf("STARQ %s: se=%#x fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+	    g->name, se_pa, fw, (fw >> 8) & 0xffu, starq_rd(g->se, SE_STATUS),
+	    tx, rx, starq_rd(g->se, 0x908));
+	if (((fw >> 8) & 0xffu) != 3u || (starq_rd(g->se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("STARQ %s: needs bootloader-loaded I2C firmware and 32-bit FIFOs\n",
+		    g->name);
+		return false;
+	}
+	if (starq_rd(g->se, SE_STATUS) & 0x1001u) {
+		printf("STARQ %s: SE already busy; skipping\n", g->name);
+		return false;
+	}
+	if (!starq_geni_clocks(g)) {
+		return false;
+	}
+	starq_tlmm_cfg(sda, 1, TLMM_PULL_NONE, 0, false);   /* 2 mA, no pull */
+	starq_tlmm_cfg(scl, 1, TLMM_PULL_NONE, 0, false);
+
+	starq_wr(g->se, 0xe18, 0);          /* no GSI events */
+	starq_wr(g->se, 0xe1c, 0);          /* no external IRQ routing: poll */
+	starq_wr(g->se, 0x644, 0);
+	starq_wr(g->se, SE_IRQ_CLR, 0xffffffffu);
+	starq_wr(g->se, 0x648, 0xffffffffu);
+	starq_wr(g->se, SE_DMA, 0);
+	starq_wr(g->se, 0x28, starq_rd(g->se, 0x28) | 0x7fu);
+	starq_wr(g->se, 0xe30, starq_rd(g->se, 0xe30) | 0x0fu);
+	starq_wr(g->se, 0x24, 0x7f);
+	starq_wr(g->se, 0x20, 1);
+	starq_wr(g->se, SE_CLK_SEL, 0);
+	starq_wr(g->se, 0x48, starq_rd(g->se, 0x48) | 1u);   /* SER_M_CLK: 19.2 MHz */
+	starq_wr(g->se, SE_SCL, SE_SCL_100K);
+	starq_wr(g->se, 0x254, 0);
+	starq_wr(g->se, 0x260, SE_PACK0);
+	starq_wr(g->se, 0x264, SE_PACK1);
+	starq_wr(g->se, 0x284, SE_PACK0);
+	starq_wr(g->se, 0x288, SE_PACK1);
+	starq_wr(g->se, SE_TX_WM, 0);
+	starq_wr(g->se, 0x810, 0);
+	starq_wr(g->se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	starq_wr(g->se, SE_IRQ_EN, SE_EVENTS);
+	if (starq_rd(g->se, 0x260) != SE_PACK0 || starq_rd(g->se, 0x264) != SE_PACK1 ||
+	    starq_rd(g->se, 0x284) != SE_PACK0 || starq_rd(g->se, 0x288) != SE_PACK1 ||
+	    starq_rd(g->se, 0x254) != 0) {
+		printf("STARQ %s: packing readback mismatch; stopping\n", g->name);
+		return false;
+	}
+	if ((starq_rd(g->se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (starq_rd(g->se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("STARQ %s: inherited FIFO data; stopping\n", g->name);
+		return false;
+	}
+	return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* S2DOS05 over a bit-banged I2C bus (i2c-21, TLMM gpio 127/128)      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The mainline DT drives this bus with i2c-gpio (sda-gpios/scl-gpios with
+ * GPIO_OPEN_DRAIN, i2c-gpio,delay-us = <2>, external pull-ups, single
+ * master).  The pads have no open-drain mode here, so the driver emulates
+ * one: a "high" level releases SDA as an input (the external pull-up makes
+ * it high) and only a "low" level drives it.  SCL is master-driven
+ * push-pull, which is safe because the bus has a single master and the
+ * slave never stretches the clock.
+ */
+#define S2_HALF_US 2
+
+static void
+s2_sda_release(void)
+{
+	starq_wr(starq_tlmm, TLMM_CTL(STARQ_I2C21_SDA),
+	    (starq_rd(starq_tlmm, TLMM_CTL(STARQ_I2C21_SDA)) & ~TLMM_OE));
+	delay(S2_HALF_US);
+}
+
+static void
+s2_sda_low(void)
+{
+	/* Latch low first, then enable the output, so no high pulse is driven. */
+	uint32_t io = starq_rd(starq_tlmm, TLMM_IO(STARQ_I2C21_SDA));
+	starq_wr(starq_tlmm, TLMM_IO(STARQ_I2C21_SDA), io & ~TLMM_OUT_HIGH);
+	starq_wr(starq_tlmm, TLMM_CTL(STARQ_I2C21_SDA),
+	    starq_rd(starq_tlmm, TLMM_CTL(STARQ_I2C21_SDA)) | TLMM_OE);
+	delay(S2_HALF_US);
+}
+
+static bool
+s2_sda_level(void)
+{
+	return (starq_rd(starq_tlmm, TLMM_IO(STARQ_I2C21_SDA)) & TLMM_IN) != 0;
+}
+
+static void
+s2_scl(bool high)
+{
+	uint32_t io = starq_rd(starq_tlmm, TLMM_IO(STARQ_I2C21_SCL));
+	starq_wr(starq_tlmm, TLMM_IO(STARQ_I2C21_SCL),
+	    high ? (io | TLMM_OUT_HIGH) : (io & ~TLMM_OUT_HIGH));
+	delay(S2_HALF_US);
+}
+
+static void
+s2_start(void)
+{
+	s2_sda_release();
+	s2_scl(true);
+	s2_sda_low();
+	s2_scl(false);
+}
+
+static void
+s2_stop(void)
+{
+	s2_scl(false);
+	s2_sda_low();
+	s2_scl(true);
+	s2_sda_release();
+}
+
+/* Returns true when the slave acknowledged the byte. */
+static bool
+s2_byte(uint8_t b)
+{
+	for (unsigned i = 0; i < 8; ++i) {
+		if (b & 0x80u) {
+			s2_sda_release();
+		} else {
+			s2_sda_low();
+		}
+		s2_scl(true);
+		s2_scl(false);
+		b <<= 1;
+	}
+	s2_sda_release();           /* let the slave drive the ACK bit */
+	s2_scl(true);
+	bool ack = !s2_sda_level();
+	s2_scl(false);
+	return ack;
+}
+
+/* One byte, master NAK: this driver only ever reads single registers. */
+static uint8_t
+s2_read_byte(void)
+{
+	uint8_t b = 0;
+	s2_sda_release();
+	for (unsigned i = 0; i < 8; ++i) {
+		s2_scl(true);
+		b = (uint8_t)((b << 1) | (s2_sda_level() ? 1u : 0u));
+		s2_scl(false);
+	}
+	s2_sda_release();
+	s2_scl(true);
+	s2_scl(false);
+	return b;
+}
+
+static bool
+s2_write(uint8_t reg, uint8_t value)
+{
+	s2_start();
+	bool ok = s2_byte((uint8_t)(S2DOS05_ADDR << 1));
+	ok = ok && s2_byte(reg);
+	ok = ok && s2_byte(value);
+	s2_stop();
+	return ok;
+}
+
+static bool
+s2_read(uint8_t reg, uint8_t *value)
+{
+	s2_start();
+	bool ok = s2_byte((uint8_t)(S2DOS05_ADDR << 1));
+	ok = ok && s2_byte(reg);
+	s2_start();                 /* repeated start */
+	ok = ok && s2_byte((uint8_t)((S2DOS05_ADDR << 1) | 1u));
+	if (ok) {
+		*value = s2_read_byte();
+	}
+	s2_stop();
+	return ok;
+}
+
+/*
+ * Power the touch controller: DVDD 1.8V on LDO2, AVDD 3.0V on LDO3, then
+ * both enables.  The bootloader leaves both rails on (regulator_boot_on), so
+ * this is usually a no-op that also reports the chip id.
+ */
+static bool
+s2dos05_touch_power(void)
+{
+	uint8_t id = 0, en = 0;
+
+	/* Both pads as plain GPIO outputs, 2 mA, no internal pull (the bus has
+	 * external pull-ups, the DT sets bias-disable and drive-strength 2). */
+	starq_tlmm_cfg(STARQ_I2C21_SDA, 0, TLMM_PULL_NONE, 0, true);
+	starq_tlmm_cfg(STARQ_I2C21_SCL, 0, TLMM_PULL_NONE, 0, true);
+	s2_scl(true);
+	s2_sda_release();
+
+	if (!s2_read(S2DOS05_DEV_ID, &id)) {
+		printf("STARQ TOUCH: S2DOS05 at 0x60 did not answer; rails left as boot left them\n");
+		return false;
+	}
+	printf("STARQ TOUCH: S2DOS05 dev-id=%#x\n", id);
+	if (!s2_read(S2DOS05_EN, &en)) {
+		printf("STARQ TOUCH: S2DOS05 EN read failed\n");
+		return false;
+	}
+	printf("STARQ TOUCH: S2DOS05 EN=%#x before\n", en);
+	if (!s2_write(S2DOS05_LDO2, (uint8_t)S2DOS05_VSEL_LDO2_1P8) ||
+	    !s2_write(S2DOS05_LDO3, (uint8_t)S2DOS05_VSEL_LDO3_3P0)) {
+		printf("STARQ TOUCH: S2DOS05 voltage select failed\n");
+		return false;
+	}
+	if (!s2_write(S2DOS05_EN, (uint8_t)(en | S2DOS05_EN_LDO2 | S2DOS05_EN_LDO3))) {
+		printf("STARQ TOUCH: S2DOS05 enable failed\n");
+		return false;
+	}
+	/* regulator-enable-ramp-delay is 12 ms in both DTs. */
+	starq_wait(12);
+	if (s2_read(S2DOS05_EN, &en)) {
+		printf("STARQ TOUCH: S2DOS05 EN=%#x after; expect bits 1 and 2\n", en);
+	}
+	return (en & (S2DOS05_EN_LDO2 | S2DOS05_EN_LDO3)) ==
+	       (S2DOS05_EN_LDO2 | S2DOS05_EN_LDO3);
+}
+
+/* ------------------------------------------------------------------ */
+/* Samsung S6SY761 touch controller                                   */
+/* ------------------------------------------------------------------ */
+
+static struct {
+	int  native;                /* sweetfb_native: report the whole panel */
+	bool down[TS_FINGERS];
+	unsigned x[TS_FINGERS], y[TS_FINGERS];
+	unsigned max_x, max_y, tx, rx;
+	bool irq_poll;              /* trust the interrupt line as a hint */
+} ts;
+
+static struct starq_geni *touch_se = &starq_touch_se;
+
+static int
+ts_write(uint8_t reg, const uint8_t *data, unsigned len)
+{
+	uint8_t tx[4];
+	if (len > 3) {
+		return EINVAL;
+	}
+	tx[0] = reg;
+	for (unsigned i = 0; i < len; ++i) {
+		tx[1 + i] = data[i];
+	}
+	return starq_geni_msg(touch_se, TS_ADDR, tx, len + 1, NULL, 0, false);
+}
+
+static int
+ts_read(uint8_t reg, uint8_t *buf, unsigned len)
+{
+	return starq_geni_read(touch_se, TS_ADDR, reg, buf, len);
+}
+
+static unsigned
+ts_be16(const uint8_t *p)
+{
+	return ((unsigned)p[0] << 8) | p[1];
+}
+
+static void
+ts_release_all(void)
+{
+	for (unsigned i = 0; i < TS_FINGERS; ++i) {
+		if (ts.down[i]) {
+			ts.down[i] = false;
+			sweet_hid_touch((int)i, 0, (int)ts.x[i], (int)ts.y[i]);
+		}
+	}
+}
+
+/* Panel pixel for a 12-bit raw coordinate (the IC reports its own grid). */
+static unsigned
+ts_scale(unsigned raw, unsigned panel)
+{
+	if (raw > 4095) {
+		raw = 4095;
+	}
+	return raw * panel / 4096;
+}
+
+/*
+ * One 8-byte event:
+ *   byte 0   bits 1:0 event id (0 = coordinate), 5:2 touch id (1-based),
+ *            7:6 action (1 press, 2 move, 3 release, 0 none)
+ *   bytes 1-3 x = [1] << 4 | [3] >> 4, y = [2] << 4 | [3] & 0xf
+ *   byte 4   touch major, byte 5 minor, byte 6 & 0x3f pressure,
+ *   byte 7 & 0x3f events left in the queue
+ */
+static void
+ts_report(const uint8_t *ev)
+{
+	if ((ev[0] & 3u) != 0 || !(ev[0] & 0x3cu)) {
+		return;                 /* status/info event or no touch id */
+	}
+	unsigned tid = ((ev[0] & 0x3cu) >> 2) - 1;
+	unsigned action = (ev[0] & 0xc0u) >> 6;
+	if (tid >= TS_FINGERS) {
+		return;
+	}
+	/* Panel pixels: SweetHID.cpp maps them to the presented display. */
+	unsigned x = ts_scale(((unsigned)ev[1] << 4) | (ev[3] >> 4), SWEET_PANEL_WIDTH);
+	unsigned y = ts_scale(((unsigned)ev[2] << 4) | (ev[3] & 0x0fu), SWEET_PANEL_HEIGHT);
+
+	if (action == 1 || action == 2) {
+		if (!ts.down[tid]) {
+			printf("STARQ TOUCH: down id=%u x=%u y=%u\n", tid, x, y);
+		}
+		ts.down[tid] = true;
+		ts.x[tid] = x;
+		ts.y[tid] = y;
+		sweet_hid_touch((int)tid, 1, (int)x, (int)y);
+	} else if (action == 3 && ts.down[tid]) {
+		ts.down[tid] = false;
+		sweet_hid_touch((int)tid, 0, (int)ts.x[tid], (int)ts.y[tid]);
+	}
+}
+
+static void
+ts_process(const uint8_t *evs, unsigned count)
+{
+	for (unsigned i = 0; i < count; ++i) {
+		if (evs[i * TS_EVENT_SIZE] != 0) {
+			ts_report(evs + i * TS_EVENT_SIZE);
+		}
+	}
+}
+
+/*
+ * Drain the event stack.  One event is read at a time (8 bytes); the
+ * READ_ALL command then fetches the remaining ones in chunks that fit the
+ * 32-word RX FIFO.  Reading is what de-asserts the interrupt line: there is
+ * no acknowledge register.
+ */
+static int
+ts_events(void)
+{
+	uint8_t ev[TS_EVENT_SIZE];
+	int err = ts_read(TS_READ_ONE, ev, sizeof(ev));
+	if (err) {
+		return err;
+	}
+	if (ev[0] == 0) {
+		return 0;               /* queue empty */
+	}
+	unsigned left = ev[7] & 0x3fu;
+	if (left > TS_EVENT_COUNT - 1) {
+		/* Inconsistent queue: drop it and release every finger. */
+		(void)ts_write(TS_CLEAR_STACK, NULL, 0);
+		ts_release_all();
+		return EIO;
+	}
+	ts_process(ev, 1);
+	while (left) {
+		/* 80 bytes per transfer: below the driver's 90-byte FIFO limit. */
+		unsigned n = left > 10 ? 10 : left;
+		uint8_t buf[10 * TS_EVENT_SIZE];
+		err = ts_read(TS_READ_ALL, buf, n * TS_EVENT_SIZE);
+		if (err) {
+			return err;
+		}
+		ts_process(buf, n);
+		left -= n;
+	}
+	return 0;
+}
+
+/*
+ * The IC is already running - the rails are boot-on and there is no reset
+ * GPIO - but it may still be booting when this thread starts, so wait up to
+ * 2 s (the vendor driver's 20 ms x 100) for the boot-complete info event.
+ */
+static bool
+ts_wait_boot(void)
+{
+	uint8_t ev[TS_EVENT_SIZE];
+	for (unsigned i = 0; i < 100; ++i) {
+		if (!ts_read(TS_READ_ONE, ev, sizeof(ev))) {
+			/*
+			 * s6sy761_power_on() reads the event field as bits 5:2
+			 * ((ev[0] >> 2) & 0xf) and wants an info event whose
+			 * payload is S6SY761_INFO_BOOT_COMPLETE.
+			 */
+			unsigned id = (ev[0] >> 2) & 0x0fu;
+			if ((id == TS_EVENT_ID_INFO || id == TS_EVENT_ID_VENDOR_INFO) &&
+			    ev[1] == TS_BOOT_COMPLETE) {
+				return true;
+			}
+		}
+		starq_wait(20);
+	}
+	return false;
+}
+
+static void
+ts_thread(void *arg, wait_result_t result)
+{
+	uint8_t buf[16];
+	unsigned errors = 0, idle_ticks = 0;
+	(void)arg;
+	(void)result;
+
+	printf("STARQ TOUCH: worker started\n");
+	if (!ts_wait_boot()) {
+		printf("STARQ TOUCH: no boot-complete event; probing anyway\n");
+	}
+	int err = ts_read(TS_BOOT_STATUS, buf, 1);
+	if (err || buf[0] != TS_BS_APPL) {
+		printf("STARQ TOUCH: boot status err=%d value=%#x (want %#x application)\n",
+		    err, err ? 0 : buf[0], TS_BS_APPL);
+	}
+	err = ts_read(TS_FW_INTEGRITY, buf, 1);
+	if (err || !(buf[0] & TS_FW_OK)) {
+		printf("STARQ TOUCH: firmware integrity err=%d value=%#x\n",
+		    err, err ? 0 : buf[0]);
+	}
+	if (!ts_read(TS_DEVICE_ID, buf, 3)) {
+		printf("STARQ TOUCH: S6SY761 id %02x%02x%02x\n", buf[0], buf[1], buf[2]);
+	}
+	if (!ts_read(TS_PANEL_INFO, buf, 11)) {
+		ts.max_x = ts_be16(buf);
+		ts.max_y = ts_be16(buf + 2);
+		ts.tx = buf[8] ? buf[8] : 1;
+		ts.rx = buf[9];
+		printf("STARQ TOUCH: panel %ux%u tx=%u rx=%u, reporting %ux%u panel pixels "
+		    "(sweetfb_native=%d)\n", ts.max_x, ts.max_y, ts.tx, ts.rx,
+		    SWEET_PANEL_WIDTH, SWEET_PANEL_HEIGHT, ts.native);
+	}
+	/* Touch functionality: bit 0 of the 16-bit word at 0x30. */
+	const uint8_t func[2] = {(uint8_t)(TS_FUNC_TOUCH & 0xffu),
+	    (uint8_t)(TS_FUNC_TOUCH >> 8)};
+	if (ts_write(TS_TOUCH_FUNC, func, sizeof(func))) {
+		printf("STARQ TOUCH: TOUCH_FUNCTION write failed; stopping\n");
+		goto out;
+	}
+	/* SENSE_ON is a bare one-byte command (i2c_smbus_write_byte). */
+	if (ts_write(TS_SENSE_ON, NULL, 0)) {
+		printf("STARQ TOUCH: SENSE_ON failed; stopping\n");
+		goto out;
+	}
+
+	for (;;) {
+		/*
+		 * Level-sensitive interrupt on gpio 120, active low in the
+		 * vendor DT and active high in mainline.  The line is only a
+		 * hint: read it, but poll anyway every 100 ms and always
+		 * while a finger is down, so a wrong polarity cannot lose
+		 * contact.
+		 */
+		bool active = true;
+		if (ts.irq_poll) {
+			active = !(starq_rd(starq_tlmm, TLMM_IO(STARQ_TOUCH_IRQ)) & TLMM_IN);
+		}
+		bool any_down = false;
+		for (unsigned i = 0; i < TS_FINGERS; ++i) {
+			any_down |= ts.down[i];
+		}
+		if (active || any_down || (++idle_ticks % 12u) == 0) {
+			int e = ts_events();
+			if (e) {
+				if ((errors++ % 100u) == 0) {
+					printf("STARQ TOUCH: event read err=%d irq=%#x\n",
+					    e, touch_se->irq_status);
+				}
+				if (errors == 10) {
+					ts_release_all();
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		starq_wait(8);
+	}
+out:
+	ts_release_all();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ts_start(void)
+{
+	thread_t thread;
+	int enabled = 1;
+	(void)PE_parse_boot_argn("starqtouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetfb_native", &ts.native, sizeof(ts.native));
+	/*
+	 * starqtouchirq=0 ignores the interrupt line and always polls (the
+	 * safe choice if the polarity is wrong); the line is used as an
+	 * active-low hint by default, as the vendor driver requests it.
+	 */
+	ts.irq_poll = 1;
+	(void)PE_parse_boot_argn("starqtouchirq", &ts.irq_poll, sizeof(ts.irq_poll));
+	if (!enabled) {
+		printf("STARQ TOUCH: disabled (starqtouch=0)\n");
+		return;
+	}
+	starq_tlmm_cfg(STARQ_TOUCH_IRQ, 0, TLMM_PULL_NONE, 0, false);
+	if (!starq_geni_init(touch_se, STARQ_I2C_TOUCH_SE, STARQ_TOUCH_SDA, STARQ_TOUCH_SCL)) {
+		return;
+	}
+	if (!s2dos05_touch_power()) {
+		printf("STARQ TOUCH: touch rails are not confirmed on; probing anyway\n");
+	}
+	/*
+	 * Identity probe before the thread starts, so a wrong bus shows up as
+	 * one line instead of a thread that never gets events.
+	 */
+	touch_se->probing = true;
+	uint8_t id[3] = {0};
+	int err = ts_read(TS_DEVICE_ID, id, sizeof(id));
+	uint8_t boot = 0;
+	int berr = ts_read(TS_BOOT_STATUS, &boot, 1);
+	touch_se->probing = false;
+	printf("STARQ TOUCH: probe 0x48 dev-id err=%d %02x%02x%02x boot-status err=%d %#x\n",
+	    err, id[0], id[1], id[2], berr, boot);
+	if (err && berr) {
+		printf("STARQ TOUCH: no S6SY761 answer; touch disabled\n");
+		return;
+	}
+	if (kernel_thread_start(ts_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("STARQ TOUCH: thread start failed\n");
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* MAX77705 fuel gauge (0x36) and charger (0x69) on i2c10             */
+/* ------------------------------------------------------------------ */
+
+static bool
+max_read16(struct starq_geni *g, uint8_t addr, uint8_t reg, uint16_t *value)
+{
+	uint8_t b[2];
+	if (starq_geni_read(g, addr, reg, b, sizeof(b))) {
+		return false;
+	}
+	*value = (uint16_t)(b[0] | ((uint16_t)b[1] << 8));
+	return true;
+}
+
+static bool
+max_read8(struct starq_geni *g, uint8_t addr, uint8_t reg, uint8_t *value)
+{
+	return starq_geni_read(g, addr, reg, value, 1) == 0;
+}
+
+/*
+ * Called by SweetBattery every 30 s (iokit/Kernel/arm/SweetBattery.cpp).
+ * Returns 0 for a plausible sample.  The fuel gauge needs no initialization
+ * to report these registers: the bootloader leaves it converting.
+ *
+ *   STATUS        0x00  bit 3: battery absent
+ *   SOCREP        0x06  16-bit LE in 1/256 %, so whole % = hi + (lo >= 128)
+ *   VCELL         0x09  16-bit LE, 78.125 uV/LSB (a 12-bit mantissa with a
+ *                       4-bit exponent in [15:12]; the whole word scales)
+ *   CURRENT       0x0a  signed 16-bit LE, 0.3125 mA/LSB (5 mOhm sense)
+ *   TEMPERATURE   0x08  [11:0] integer degrees C, [15] sign; log only
+ *   INT_OK        0xb2  bit 6: CHGIN_OK
+ *   DETAILS_01    0xb4  bits 3:0: 0-2 charging, 3-4 done
+ */
+int
+starqltechn_battery_read(unsigned *percent, unsigned *mv, int *ma,
+    int *external, int *charging, int *full)
+{
+	static bool fg_ready;
+	uint16_t soc, vcell, cur;
+	uint8_t status = 0, ok = 0, dtls = 0, temp = 0;
+
+	if (!fg_ready) {
+		if (!starq_geni_init(&starq_fg_se, STARQ_I2C_FG_SE, STARQ_FG_SDA, STARQ_FG_SCL)) {
+			return -1;
+		}
+		fg_ready = true;
+	}
+	if (!max_read8(&starq_fg_se, MAX77705_FG, FG_STATUS, &status) ||
+	    !max_read16(&starq_fg_se, MAX77705_FG, FG_SOCREP, &soc) ||
+	    !max_read16(&starq_fg_se, MAX77705_FG, FG_VCELL, &vcell) ||
+	    !max_read16(&starq_fg_se, MAX77705_FG, FG_CURRENT, &cur)) {
+		return -1;
+	}
+	(void)max_read8(&starq_fg_se, MAX77705_FG, FG_TEMPERATURE, &temp);
+	(void)max_read8(&starq_fg_se, MAX77705_CHG, CHG_INT_OK, &ok);
+	(void)max_read8(&starq_fg_se, MAX77705_CHG, CHG_DETAILS_01, &dtls);
+
+	unsigned pct = (unsigned)(soc >> 8) + ((soc & 0xffu) >= 128u ? 1u : 0u);
+	*percent = pct > 100 ? 100 : pct;
+	*mv = (unsigned)((uint32_t)vcell * 78125u / 1000000u);
+	/* The gauge reports charging current as positive; IOPMPowerSource wants
+	 * positive = charging, so negate the driver's sign convention. */
+	*ma = -(int)((int16_t)cur) * 15625 / 100000;
+	*external = (ok & 0x40u) != 0;
+	unsigned bat = dtls & 0x0fu;
+	*charging = *external && bat <= 2u;
+	*full = *external && (bat == 3u || bat == 4u);
+	if (*mv < 2800 || *mv > 4600) {
+		printf("STARQ BAT: implausible VCELL raw=%#x (%u mV) status=%#x temp=%#x\n",
+		    vcell, *mv, status, temp);
+		return -1;
+	}
+	if (status & 0x08u) {
+		printf("STARQ BAT: fuel gauge reports no battery (status=%#x)\n", status);
+		return -1;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+
+void
+starqltechn_hw_init(void)
+{
+	starq_gcc = ml_io_map(STARQ_GCC_PA, STARQ_GCC_SIZE);
+	starq_tlmm = ml_io_map(STARQ_TLMM_NORTH_PA, STARQ_TLMM_NORTH_SIZE);
+	if (!starq_gcc || !starq_tlmm) {
+		printf("STARQ: GCC/TLMM mapping failed; board drivers disabled\n");
+		return;
+	}
+	printf("STARQ: gcc=%#x tlmm=%#x\n", STARQ_GCC_PA, STARQ_TLMM_NORTH_PA);
+	ts_start();
+}
