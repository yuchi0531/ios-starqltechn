+/*
+ * Board config for the Samsung Galaxy S9 (SM-G9600 / SC-02K, "starqltechn",
+ * Qualcomm SDM845 / Snapdragon 845): Kryo 385 = Cortex-A75 + Cortex-A55,
+ * ARMv8.2, no PAC.
+ *
+ * To this kernel SDM845 is the same machine as SM7150: a generic ARM board
+ * (no APPLE_ARM64_ARCH_FAMILY, so none of Apple's implementation-defined
+ * system registers exist), 16K pages, GICv3 with two security states where
+ * Group 0 belongs to TrustZone, the same Qualcomm architected-timer PPI
+ * numbering and the same RPMh TCS layout.  SWEET.h is therefore the
+ * machine layer for both boards; this header only sets the board constants
+ * it lets a board override, then includes it.
+ *
+ * Hardware wiring specific to SM7150 stays gated on
+ * ARM64_BOARD_CONFIG_SWEET and is not compiled for this board; the SDM845
+ * drivers are in the same patch series (bsd/dev/starqltechn_hw.c).
+ */
+
+#ifndef _PEXPERT_ARM64_STARQLTECHN_H
+#define _PEXPERT_ARM64_STARQLTECHN_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define STARQLTECHN               1
+
+/*
+ * Bootloader splash framebuffer: reserved-memory "framebuffer_mem" in both
+ * the mainline (sdm845-samsung-starqltechn.dts) and the Samsung vendor DT,
+ * memory@9d400000, 1440x2960 a8r8g8b8, 0x02400000 bytes reserved.  start.s
+ * maps it VA=PA before any driver exists and sweet_early.c draws its phase
+ * markers there, so the geometry and address are compile-time constants.
+ * The panel starts 20MB into the 32MB block at 0x9c000000 and ends 4.3MB
+ * into the next block, so the bootstrap mapping covers two blocks.
+ * (No type suffixes: start.s expands these inside an assembler MOV64
+ * expression.)
+ */
+#define SWEET_FB_BASE             0x9d400000
+#define SWEET_FB_WIDTH            1440
+#define SWEET_FB_HEIGHT           2960
+#define SWEET_FB_STRIDE           5760        /* bytes per line, 1440 * 4 */
+#define SWEET_FB_L2_BASE          0x9c000000  /* 32MB-aligned mapping base */
+#define SWEET_FB_L2_BLOCKS        2
+
+/* Panel pixels: the digitizer reports these, SweetHID crops/centres them. */
+#define SWEET_PANEL_WIDTH         1440
+#define SWEET_PANEL_HEIGHT        2960
+
+/*
+ * RPMh apps RSC drv-2: sdm845.dtsi rsc@179c0000, reg-names "drv-2" =
+ * 0x179e0000, qcom,tcs-offset = <0xd00>.  The TCS layout (stride 0x2a0,
+ * 0x14 per command, RSC major version < 3) and the cmd-db locator at
+ * 0x0c3f000c are the same as on SM7150.
+ */
+#define SWEET_RH_RSC_PA           0x179e0000u
+#define SWEET_RH_TCS_PA           0x179e0d00u
+
+/* The machine layer: SWEET (generic Qualcomm), timer INTID 19, SGI 1, 8
+ * CPUs, GICv3 register definitions. */
+#include <pexpert/arm64/SWEET.h>
+
+#endif /* ! _PEXPERT_ARM64_STARQLTECHN_H */
