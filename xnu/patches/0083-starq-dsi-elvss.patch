 starqltechn_hw_init(void)
@@ -1085,5 +1462,6 @@
 	}
 	printf("STARQ: gcc=%#x tlmm=%#x\n", STARQ_GCC_PA, STARQ_TLMM_NORTH_PA);
 	ts_start();
+	starq_dsi_elvss();
 }
